<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ClassShout ←→ ClassIsland 联动插件。

    目标框架**跟着宿主走**，不能自己定：ClassIsland 2.1.0.x 跑在 net8.0-windows 上，
    2.1.1 起换成了 net10.0-windows10.0.19041.0。框架对不上的插件装进宿主里
    加载不起来，而这件事在"安装"那一刻不会被发现 —— 表现只是"装了但没反应"。

    所以下面的 ClassIslandHostTfm 按所选的 SDK 版本自动取值，也可以在命令行覆盖：

        dotnet build -c Release -p:ClassIslandPluginSdkVersion=2.1.0.1     # → net8.0-windows
        dotnet build -c Release -p:ClassIslandPluginSdkVersion=2.1.1.1     # → net10.0-windows

    ClassIsland.PluginSdk 排除 runtime/native：宿主自己带着 Core 与 Shared，
    插件再复制一份进去只会造成类型来自两个程序集实例、互相认不出来。
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ClassShout.ClassIslandPlugin</RootNamespace>
    <AssemblyName>ClassShout.ClassIslandPlugin</AssemblyName>

    <!--
      要针对哪个 ClassIsland 版本编译。可在命令行覆盖：

          dotnet build -c Release -p:ClassIslandPluginSdkVersion=2.1.1.1

      默认取 2.1.0.1：它的 apiVersion 是两者中更低的那个，装得进 2.1.0.1 与 2.1.1.1 两种宿主，
      所以发行版用它。要为更高的宿主单独出一份时再加 -p 覆盖。

      为什么同一个插件要出两份：ClassIsland 2.1.0.1 与 2.1.1.1 之间引入了破坏性变更
      （与本插件用到的 API 无关，但程序集版本变了），针对一个版本编译出来的插件
      装到另一个版本上不保证能加载。两份分别对应各自的宿主。
    -->
    <ClassIslandPluginSdkVersion Condition="'$(ClassIslandPluginSdkVersion)' == ''">2.1.0.1</ClassIslandPluginSdkVersion>

    <!--
      宿主的目标框架：2.1.0.x 那一代是 net8.0-windows，2.1.1 起是 net10.0-windows。
      （与 ClassIsland.PluginSdk 包里 lib/ 下的目录一致：2.1.0.1 是 lib/net8.0，
      2.1.1.1 是 lib/net10.0。）
    -->
    <ClassIslandHostTfm Condition="'$(ClassIslandHostTfm)' == '' and $([MSBuild]::VersionLessThan('$(ClassIslandPluginSdkVersion)', '2.1.1'))">net8.0-windows</ClassIslandHostTfm>
    <ClassIslandHostTfm Condition="'$(ClassIslandHostTfm)' == ''">net10.0-windows</ClassIslandHostTfm>

    <TargetFramework>$(ClassIslandHostTfm)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="$(ClassIslandPluginSdkVersion)">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      让 tools/SelfTest 能直接验证报文解析。这一段逻辑踩过坑（见 ReadRequestAsync 的注释），
      而它跑在 ClassIsland 宿主里、没法靠"启动宿主看一眼"来回归，所以单独放行给它测。
    -->
    <InternalsVisibleTo Include="ClassShout.ClassIslandPlugin.SelfTest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      tools/ 下有自己的项目（报文解析自测）。它们的 obj/**/*.cs 会被本项目的默认通配
      一起扫进来，表现是一大片"特性重复"（AssemblyInfo 生成了两遍）的编译错误 ——
      项目在仓库根目录时，必须自己把子项目挡在外面。
    -->
    <Compile Remove="tools/**" />
    <EmbeddedResource Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!--
      许可文本随包一起发出去：只落到输出目录，dotnet publish -p:CreateCipx=true 才会把它打进 .cipx。
      这一条不是硬性门槛（打包脚本只提示、不报错），但发二进制却不附许可文本，
      拿到包的人就无从知道它按什么条款提供。
    -->
    <None Update="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
